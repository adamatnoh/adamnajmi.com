---
interface Props {
  url: string;
  tilt?: boolean;
  class?: string;
}
const { url, tilt = false, class: className } = Astro.props;
---

<div class:list={['hss-tilt-wrap min-w-0', className]} data-tilt={tilt ? '' : undefined}>
  <div
    class="hss-tilt relative rounded-xl border border-white/15 bg-black shadow-2xl shadow-green-500/5 overflow-hidden"
  >
    <div class="flex items-center gap-2 px-3 py-2 border-b border-white/10 bg-white/[0.03]">
      <span class="w-2.5 h-2.5 rounded-full bg-red-500" aria-hidden="true"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-yellow-500" aria-hidden="true"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-green-500" aria-hidden="true"></span>
      <div
        class="ml-2 flex-1 min-w-0 rounded bg-white/5 border border-white/10 px-2 py-0.5 font-mono text-[11px] text-white/50 truncate"
      >
        <span class="text-green-400" aria-hidden="true">🔒</span>
        {url}
      </div>
    </div>
    <slot />
    <div class="hss-glare pointer-events-none absolute inset-0" aria-hidden="true"></div>
  </div>
</div>

<style>
  .hss-tilt-wrap {
    perspective: 1200px;
  }
  .hss-tilt {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.4s ease;
  }
  .hss-glare {
    opacity: 0;
    background: radial-gradient(
      600px circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.08),
      transparent 40%
    );
    transition: opacity 0.3s ease;
  }
  [data-tilt]:hover .hss-glare {
    opacity: 1;
  }
  [data-tilt]:hover .hss-tilt {
    transition: transform 0.08s linear;
  }
</style>

<script>
  const canTilt =
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canTilt) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((wrap) => {
      const card = wrap.querySelector<HTMLElement>('.hss-tilt');
      if (!card) return;
      wrap.addEventListener('pointermove', (e) => {
        const r = wrap.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--ry', `${(x - 0.5) * 8}deg`);
        card.style.setProperty('--rx', `${(0.5 - y) * 6}deg`);
        card.style.setProperty('--gx', `${x * 100}%`);
        card.style.setProperty('--gy', `${y * 100}%`);
      });
      wrap.addEventListener('pointerleave', () => {
        card.style.setProperty('--ry', '0deg');
        card.style.setProperty('--rx', '0deg');
      });
    });
  }
</script>
