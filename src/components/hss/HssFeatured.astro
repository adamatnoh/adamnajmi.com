---
import Word from '../Word.astro';
import FeaturedChrome from '../FeaturedChrome.astro';
import BrowserFrame from './BrowserFrame.astro';
import Carousel from './Carousel.astro';
import { FEATURES, HIGHLIGHTS, STACK } from '../../data/hss';
---

<FeaturedChrome
  id="hss-featured-title"
  title="Hospital Scheduling System"
  slug="hospital-scheduling-system"
  badge="★ FYP project · UTM"
  badgeTone="green"
  accent="green"
  liveHost="hss.adamnajmi.com"
  liveHref="https://hss.adamnajmi.com"
>
  <p class="mt-2 max-w-3xl font-mono text-sm leading-relaxed text-white/70">
    My <Word word="final" /> year project at UTM (2023), rebuilt from scratch in 2026 — a duty-roster
    app where hospital departments generate fair on-call, ward and shift rosters, then let doctors request
    leave and swaps.
  </p>

  <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-[minmax(0,1fr)_17rem]">
    <div>
      <ul class="grid gap-x-4 gap-y-1.5 font-mono text-[13px] text-white/70 sm:grid-cols-2">
        {
          FEATURES.map((f) => (
            <li>
              <span class="text-green-400/60" aria-hidden="true">
                &gt;
              </span>{' '}
              {f}
            </li>
          ))
        }
      </ul>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Built with">
        {
          STACK.map((t) => (
            <li class="rounded bg-cyan-400/10 px-2 py-0.5 font-mono text-[10px] text-cyan-400">
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-1.5 rounded-lg border border-white/10 bg-black p-3 font-mono text-xs">
      <p><span class="text-green-400">➜</span> <span class="text-white">login --demo</span></p>
      <p class="leading-relaxed text-white/60">
        Use the demo buttons on the login page to sign in as
        <span class="text-white">Dr Adam</span> (admin),
        <span class="text-white">Dr Farah</span> (scheduler) or
        <span class="text-white">Dr Firdaus</span> (doctor).
      </p>
      <p class="text-white/40">password: <code class="text-cyan-400">password</code></p>
    </div>
  </div>

  <BrowserFrame url="hss.adamnajmi.com" tilt class="mt-6">
    <Carousel slides={HIGHLIGHTS} label="HSS screenshots" interval={4000} />
  </BrowserFrame>

  <div class="mt-5 flex flex-wrap items-center gap-3 font-mono text-sm">
    <a
      href="/hss/live"
      class="group inline-flex items-center gap-2 rounded-md bg-green-400 px-4 py-2 font-bold text-black transition hover:bg-green-300"
    >
      <span aria-hidden="true">▶</span> Launch live demo
      <span class="transition group-hover:translate-x-0.5" aria-hidden="true">↗</span>
    </a>
    <a
      href="/hss"
      class="inline-flex items-center gap-2 rounded-md border border-white/20 px-4 py-2 text-white transition hover:bg-white hover:text-black"
    >
      Take the guided tour <span aria-hidden="true">→</span>
    </a>
  </div>
</FeaturedChrome>
