---
import Word from '../Word.astro';
import BrowserFrame from './BrowserFrame.astro';
import Carousel from './Carousel.astro';
import { FEATURES, HIGHLIGHTS, STACK } from '../../data/hss';
---

<article
  class="relative rounded-xl border border-green-500/20 bg-gradient-to-b from-green-500/[0.06] to-transparent p-5 sm:p-6 mb-6 overflow-hidden"
  aria-labelledby="hss-featured-title"
  data-reveal
>
  <div class="flex flex-wrap items-center gap-2 mb-3 font-mono text-xs">
    <span
      class="text-green-400 border border-green-400/30 bg-green-400/10 rounded-full px-2.5 py-0.5"
      >★ featured</span
    >
    <span
      class="inline-flex items-center gap-1.5 text-white/70 border border-white/15 rounded-full px-2.5 py-0.5"
    >
      <span class="relative flex w-2 h-2" aria-hidden="true">
        <span class="absolute inset-0 rounded-full bg-green-400 animate-ping opacity-60"></span>
        <span class="relative w-2 h-2 rounded-full bg-green-400"></span>
      </span>
      live at hss.adamnajmi.com
    </span>
  </div>

  <h3 id="hss-featured-title" class="font-mono font-bold text-white text-xl md:text-2xl">
    <span class="text-green-400" aria-hidden="true">$</span> hospital-scheduling-system
  </h3>
  <p class="mt-2 text-white/70 font-mono text-sm leading-relaxed max-w-3xl">
    My <Word word="final" /> year project at UTM (2023), rebuilt from scratch in 2026 — a duty-roster
    app where hospital departments generate fair on-call, ward and shift rosters, then let doctors request
    leave and swaps.
  </p>

  <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-[minmax(0,1fr)_17rem]">
    <div>
      <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-1.5 font-mono text-[13px] text-white/70">
        {
          FEATURES.map((f) => (
            <li>
              <span class="text-green-400/60" aria-hidden="true">
                &gt;
              </span>{' '}
              {f}
            </li>
          ))
        }
      </ul>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Built with">
        {
          STACK.map((t) => (
            <li class="text-[10px] font-mono text-cyan-400 bg-cyan-400/10 px-2 py-0.5 rounded">
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-lg border border-white/10 bg-black p-3 font-mono text-xs space-y-1.5">
      <p><span class="text-green-400">➜</span> <span class="text-white">login --demo</span></p>
      <p class="text-white/60 leading-relaxed">
        Use the demo buttons on the login page to sign in as
        <span class="text-white">Dr Adam</span> (admin),
        <span class="text-white">Dr Farah</span> (scheduler) or
        <span class="text-white">Dr Firdaus</span> (doctor).
      </p>
      <p class="text-white/40">password: <code class="text-cyan-400">password</code></p>
    </div>
  </div>

  <BrowserFrame url="hss.adamnajmi.com" tilt class="mt-6">
    <Carousel slides={HIGHLIGHTS} label="HSS screenshots" interval={4000} />
  </BrowserFrame>

  <div class="mt-5 flex flex-wrap items-center gap-3 font-mono text-sm">
    <a
      href="/hss/live"
      class="group inline-flex items-center gap-2 rounded-md bg-green-400 text-black font-bold px-4 py-2 hover:bg-green-300 transition"
    >
      <span aria-hidden="true">▶</span> Launch live demo
      <span class="transition group-hover:translate-x-0.5" aria-hidden="true">↗</span>
    </a>
    <a
      href="/hss"
      class="inline-flex items-center gap-2 rounded-md border border-white/20 text-white px-4 py-2 hover:bg-white hover:text-black transition"
    >
      Take the guided tour <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
