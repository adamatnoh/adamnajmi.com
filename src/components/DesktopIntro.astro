---
/**
 * First-visit desktop. Hidden unless the head gate in SeoHead adds
 * `desk-on` to <html> (once per session, never for deep links). The editor
 * is already rendered underneath; opening AmCode zooms it out of the icon.
 * The hello card is a small "Welcome" window: drag it by its title bar,
 * close or minimise it, and reopen it from its icon or the dock.
 * AmReader shows the resume in a second window; Doodle turns the wallpaper
 * into a scribble canvas.
 */
import AppIcon from './brand/AppIcon.astro';
import SolatWidget from './SolatWidget.astro';
import DoodleLayer from './desk/DoodleLayer.astro';
import AmReader from './desk/AmReader.astro';
import { PROFILE, RESUME_URL } from '../data/profile';
---

<div
  id="desk"
  class="desk win-running"
  role="dialog"
  aria-modal="true"
  aria-labelledby="desk-hello"
  aria-describedby="desk-hint"
  data-cipher-ui
>
  <div class="desk-wall" aria-hidden="true"></div>

  <DoodleLayer />

  <header class="desk-bar glass">
    <span class="desk-brand">
      <AppIcon name="amcode" size={16} />
      <span>adamnajmi.com</span>
    </span>
    <span class="desk-clock">
      <span class="desk-status" aria-hidden="true">
        <svg class="desk-wifi" viewBox="0 0 24 24" width="17" height="17" focusable="false">
          <path d="M2.6 9.2a13.6 13.6 0 0 1 18.8 0"></path>
          <path d="M5.7 12.6a9.2 9.2 0 0 1 12.6 0"></path>
          <path d="M8.9 15.9a4.7 4.7 0 0 1 6.2 0"></path>
          <circle cx="12" cy="19.1" r="1.25"></circle>
        </svg>
        <svg class="desk-battery" viewBox="0 0 30 14" width="27" height="13" focusable="false">
          <rect x=".8" y=".8" width="25" height="12.4" rx="3.4"></rect>
          <rect class="lvl" x="2.8" y="2.8" width="17" height="8.4" rx="1.8"></rect>
          <path d="M28.2 5.2v3.6"></path>
        </svg>
      </span>
      <span data-desk-date></span>
      <time data-desk-time>--:--:--</time>
    </span>
  </header>

  <SolatWidget />

  <ul class="desk-icons" aria-label="Apps">
    <li>
      <button type="button" class="desk-icon" data-desk-open="amcode" data-desk-first>
        <AppIcon name="amcode" size={58} />
        <span>AmCode</span>
      </button>
    </li>
    <li>
      <button type="button" class="desk-icon" data-desk-open="postam">
        <AppIcon name="postam" size={58} />
        <span>PostAm</span>
      </button>
    </li>
    <li>
      <button type="button" class="desk-icon" data-desk-open="simple">
        <AppIcon name="simple" size={58} />
        <span>Simple view</span>
      </button>
    </li>
    <li>
      <a
        class="desk-icon"
        href={RESUME_URL}
        target="_blank"
        rel="noopener"
        data-desk-open="reader"
        title="Open in AmReader"
      >
        <AppIcon name="pdf" size={58} />
        <span>resume.pdf</span>
      </a>
    </li>
    <li>
      <button type="button" class="desk-icon" data-desk-open="welcome">
        <AppIcon name="welcome" size={58} />
        <span>Welcome</span>
      </button>
    </li>
    <li>
      <button type="button" class="desk-icon" data-desk-open="doodle">
        <AppIcon name="doodle" size={58} />
        <span>Doodle</span>
      </button>
    </li>
  </ul>

  <section class="desk-win glass" data-desk-window data-win="welcome" aria-labelledby="desk-hello">
    <div class="desk-win-bar" data-desk-drag>
      <div class="desk-win-dots">
        <button
          type="button"
          class="dw-dot close"
          data-desk-win="close"
          aria-label="Close the Welcome window"
          title="Close"
          ><svg viewBox="0 0 12 12" aria-hidden="true"
            ><path d="M3.5 3.5l5 5M8.5 3.5l-5 5"></path></svg
          ></button
        >
        <button
          type="button"
          class="dw-dot min"
          data-desk-win="min"
          aria-label="Minimise the Welcome window to the dock"
          title="Minimise"
          ><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 6h6"></path></svg></button
        >
        <button
          type="button"
          class="dw-dot max"
          data-desk-win="zoom"
          aria-label="Zoom the Welcome window"
          title="Zoom"
          ><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4 8V4h4M8 4 4 8"></path></svg
          ></button
        >
      </div>
      <span class="desk-win-title">Welcome</span>
    </div>
    <div class="desk-win-body">
      <p class="desk-kicker">Hi, I'm</p>
      <h2 id="desk-hello">Adam Najmi</h2>
      <p class="desk-role">{PROFILE.role} · Johor Bahru, MY</p>
      <p class="desk-hint" id="desk-hint">
        <span class="only-fine">Double-click</span><span class="only-coarse">Tap</span>
        <b>AmCode</b> to open my portfolio as a code editor, <b>PostAm</b> to call its live API, or pick
        <b>Simple view</b> for a plain page.
      </p>
      <div class="desk-actions">
        <button type="button" class="desk-btn glass primary" data-desk-open="amcode">
          <AppIcon name="amcode" size={18} /> Open AmCode
        </button>
        <button type="button" class="desk-btn glass" data-desk-open="simple">
          <AppIcon name="simple" size={18} /> Simple view
        </button>
      </div>
    </div>
  </section>

  <AmReader />

  <nav class="desk-dock glass" aria-label="Dock">
    <button type="button" class="dock-item" data-desk-open="amcode" aria-label="AmCode">
      <AppIcon name="amcode" size={46} /><span class="dock-tip glass" aria-hidden="true"
        >AmCode</span
      >
    </button>
    <button type="button" class="dock-item" data-desk-open="postam" aria-label="PostAm">
      <AppIcon name="postam" size={46} /><span class="dock-tip glass" aria-hidden="true"
        >PostAm</span
      >
    </button>
    <button type="button" class="dock-item" data-desk-open="simple" aria-label="Simple view">
      <AppIcon name="simple" size={46} /><span class="dock-tip glass" aria-hidden="true"
        >Simple view</span
      >
    </button>
    <button type="button" class="dock-item" data-desk-open="doodle" aria-label="Doodle">
      <AppIcon name="doodle" size={46} /><span class="dock-tip glass" aria-hidden="true"
        >Doodle</span
      ><span class="dock-dot" aria-hidden="true"></span>
    </button>
    <span class="dock-sep" aria-hidden="true"></span>
    <button
      type="button"
      class="dock-item"
      data-desk-open="welcome"
      data-dock-welcome
      data-dock="welcome"
      aria-label="Welcome window"
    >
      <AppIcon name="welcome" size={46} /><span class="dock-tip glass" aria-hidden="true"
        >Welcome</span
      ><span class="dock-dot" aria-hidden="true"></span>
    </button>
    <button
      type="button"
      class="dock-item"
      data-desk-open="reader"
      data-dock="reader"
      aria-label="AmReader: resume.pdf"
    >
      <AppIcon name="reader" size={46} /><span class="dock-tip glass" aria-hidden="true"
        >AmReader</span
      ><span class="dock-dot" aria-hidden="true"></span>
    </button>
  </nav>

  <button type="button" class="desk-skip glass" data-desk-skip aria-keyshortcuts="Escape">
    Skip intro <kbd aria-hidden="true">esc</kbd>
  </button>
</div>

<script>
  import { initDoodle } from '../scripts/doodle';
  /**
   * The desktop stays in the DOM (hidden) so AmCode can return to it:
   * window.amDesk.show() shrinks the editor back into the AmCode icon.
   * Tabs and layout are untouched, so reopening restores them.
   */
  const html = document.documentElement;
  const desk = document.getElementById('desk');

  if (desk) {
    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const small = window.matchMedia('(max-width: 767px)');
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const ide = document.getElementById('ide');
    const amIcon = () => desk.querySelector<HTMLElement>('[data-desk-first]');

    // ------------------------------------------------------------------
    // Clock: HH:MM:SS in the visitor's own time, re-armed on each second
    // boundary (a fixed interval drifts and gets throttled in the background).
    // ------------------------------------------------------------------
    const timeEl = desk.querySelector<HTMLTimeElement>('[data-desk-time]');
    const dateEl = desk.querySelector<HTMLElement>('[data-desk-date]');
    const tick = () => {
      const now = new Date();
      if (timeEl) {
        timeEl.textContent = now.toLocaleTimeString([], {
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        });
        timeEl.dateTime = now.toISOString();
      }
      if (dateEl)
        dateEl.textContent = now.toLocaleDateString([], {
          weekday: 'short',
          day: 'numeric',
          month: 'short',
        });
    };
    let clockTimer = 0;
    const runClock = () => {
      window.clearTimeout(clockTimer);
      tick();
      clockTimer = window.setTimeout(runClock, 1000 - (Date.now() % 1000) + 8);
    };
    const stopClock = () => window.clearTimeout(clockTimer);
    document.addEventListener('visibilitychange', () => {
      if (!open) return;
      if (document.hidden) stopClock();
      else runClock();
    });

    let open = false; // desktop currently showing
    let busy = false; // an animation is running
    let returnFocus: HTMLElement | null = null;

    // ------------------------------------------------------------------
    // Windows (Welcome, AmReader): drag by the title bar, close, minimise
    // to the dock, zoom, reopen. The last one touched sits in front.
    // ------------------------------------------------------------------
    type WinState = 'open' | 'closed' | 'min';
    interface Win {
      el: HTMLElement;
      dock: HTMLElement | null;
      state: WinState;
      onShow?: () => void;
      focusSel?: string;
      /** Can it be dragged right now? (AmReader is a fixed sheet on phones.) */
      canDrag?: () => boolean;
    }
    const TOP = 34; // keep the title bar below the menu bar
    /**
     * Where a window may sit. Desktop: anywhere below the menu bar, as long as
     * the title bar stays above the dock. Phones: fully on screen, above
     * the Skip / Back to AmCode pill.
     */
    const bounds = (width: number, height: number) => {
      const top = small.matches ? 30 : TOP;
      const maxY = small.matches
        ? Math.max(top, window.innerHeight - height - 64) // clear of the Skip pill
        : window.innerHeight - 44;
      return { minX: 0, maxX: Math.max(0, window.innerWidth - width), minY: top, maxY };
    };
    const clampTo = (v: number, lo: number, hi: number) => Math.min(Math.max(lo, v), hi);
    const wins = new Map<string, Win>();
    const front = (w: Win) => {
      wins.forEach((o) => (o.el.style.zIndex = o === w ? '4' : '3'));
    };
    const clampWin = (w: Win) => {
      if (!w.el.style.left || w.el.hidden) return;
      const r = w.el.getBoundingClientRect();
      const b = bounds(r.width, r.height);
      const x = clampTo(r.left, b.minX, b.maxX);
      const y = clampTo(r.top, b.minY, b.maxY);
      w.el.style.left = `${Math.round(x)}px`;
      w.el.style.top = `${Math.round(y)}px`;
    };
    const resetPos = (w: Win) => {
      w.el.style.left = w.el.style.top = w.el.style.inset = w.el.style.margin = '';
    };
    const playAnim = (w: Win, cls: string, ms: number, then?: () => void) => {
      if (reduceMq.matches) return then?.();
      w.el.classList.add(cls);
      window.setTimeout(() => {
        w.el.classList.remove(cls);
        then?.();
      }, ms);
    };
    const markRunning = (w: Win, on: boolean) => {
      w.dock?.classList.toggle('is-running', on);
      if (w === wins.get('welcome')) desk.classList.toggle('win-running', on);
    };
    const hideWin = (w: Win, how: 'closed' | 'min') => {
      if (w.state !== 'open') return;
      if (how === 'min' && !w.dock?.offsetParent) how = 'closed'; // no dock on phones
      w.state = how;
      markRunning(w, how === 'min');
      if (how === 'min' && w.dock) {
        const r = w.el.getBoundingClientRect();
        const d = w.dock.getBoundingClientRect();
        const dx = d.left + d.width / 2 - (r.left + r.width / 2);
        const dy = d.top + d.height / 2 - (r.top + r.height / 2);
        w.el.style.setProperty('--dw-to', `translate(${dx}px, ${dy}px) scale(0.08)`);
        playAnim(w, 'is-minimising', 320, () => (w.el.hidden = true));
      } else {
        playAnim(w, 'is-closing', 180, () => (w.el.hidden = true));
      }
    };
    const showWin = (w: Win) => {
      if (w.state === 'open') {
        front(w);
        return playAnim(w, 'is-nudged', 300);
      }
      const wasMin = w.state === 'min';
      w.state = 'open';
      markRunning(w, true);
      w.el.hidden = false;
      front(w);
      clampWin(w);
      playAnim(w, wasMin ? 'is-restoring' : 'is-opening', wasMin ? 320 : 200);
      w.onShow?.();
      if (w.focusSel) w.el.querySelector<HTMLElement>(w.focusSel)?.focus({ preventScroll: true });
    };
    const zoomWin = (w: Win) => {
      if (small.matches) return;
      w.el.classList.toggle('is-zoomed');
      resetPos(w);
      w.onShow?.();
    };
    const addWin = (name: string, el: HTMLElement | null, opts: Partial<Win> = {}) => {
      if (!el) return;
      const w: Win = {
        el,
        dock: desk.querySelector<HTMLElement>(`[data-dock="${name}"]`),
        state: el.hidden ? 'closed' : 'open',
        ...opts,
      };
      wins.set(name, w);
      if (w.state === 'open') markRunning(w, true);
      el.addEventListener('pointerdown', () => front(w));
      const bar = el.querySelector<HTMLElement>('[data-desk-drag]');
      bar?.addEventListener('pointerdown', (e) => {
        // Mouse, pen and touch alike; the title bar is the only handle and
        // its buttons (traffic lights) never start a drag.
        if (!e.isPrimary || e.button > 0 || (w.canDrag && !w.canDrag())) return;
        if ((e.target as HTMLElement).closest('button, a, input')) return;
        e.preventDefault();
        const r = el.getBoundingClientRect();
        const ox = e.clientX - r.left;
        const oy = e.clientY - r.top;
        el.style.inset = 'auto';
        el.style.margin = '0';
        el.style.left = `${Math.round(r.left)}px`;
        el.style.top = `${Math.round(r.top)}px`;
        bar.setPointerCapture?.(e.pointerId);
        el.classList.add('is-dragging');
        const b = bounds(r.width, r.height);
        const move = (ev: PointerEvent) => {
          if (ev.pointerId !== e.pointerId) return;
          ev.preventDefault();
          const x = clampTo(ev.clientX - ox, b.minX, b.maxX);
          const y = clampTo(ev.clientY - oy, b.minY, b.maxY);
          el.style.left = `${Math.round(x)}px`;
          el.style.top = `${Math.round(y)}px`;
        };
        const up = () => {
          el.classList.remove('is-dragging');
          bar.removeEventListener('pointermove', move);
          bar.removeEventListener('pointerup', up);
          bar.removeEventListener('pointercancel', up);
        };
        bar.addEventListener('pointermove', move);
        bar.addEventListener('pointerup', up);
        bar.addEventListener('pointercancel', up);
      });
      bar?.addEventListener('dblclick', (e) => {
        if (!(e.target as HTMLElement).closest('button')) zoomWin(w);
      });
    };
    addWin('welcome', desk.querySelector<HTMLElement>('[data-win="welcome"]'), {
      focusSel: '.desk-btn.primary',
    });

    // ------------------------------------------------------------------
    // AmReader: pdf.js (lazy) inside the window; <object> if that fails.
    // ------------------------------------------------------------------
    const readerEl = desk.querySelector<HTMLElement>('[data-win="reader"]');
    let reader: import('../scripts/amreader').Reader | null = null;
    let readerLoading: Promise<void> | null = null;
    const loadReader = () => {
      if (!readerEl || readerLoading) return readerLoading;
      const status = readerEl.querySelector<HTMLElement>('[data-rd-status]');
      const src = readerEl.dataset.src || '/file/resume.pdf';
      readerLoading = import('../scripts/amreader')
        .then((m) => m.mountReader(readerEl, src))
        .then((r) => {
          reader = r;
        })
        .catch(() => {
          readerEl.dataset.fallback = 'true';
          const pages = readerEl.querySelector<HTMLElement>('[data-rd-pages]');
          if (pages) {
            pages.innerHTML = '';
            const obj = document.createElement('object');
            obj.className = 'rd-object';
            obj.type = 'application/pdf';
            obj.data = src;
            obj.setAttribute('aria-label', 'resume.pdf');
            const a = document.createElement('a');
            a.href = src;
            a.target = '_blank';
            a.rel = 'noopener';
            a.textContent = 'Open resume.pdf';
            obj.append(a);
            pages.append(obj);
          }
          if (status) status.textContent = '';
        });
      return readerLoading;
    };
    addWin('reader', readerEl, {
      focusSel: '[data-rd-view]',
      canDrag: () => !small.matches,
      onShow: () => {
        void loadReader();
        reader?.refit();
      },
    });
    readerEl?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-rd]');
      if (!b) return;
      const a = b.dataset.rd;
      if (a === 'thumbs') {
        const on = readerEl.classList.toggle('no-thumbs');
        b.setAttribute('aria-pressed', String(!on));
        return reader?.refit();
      }
      if (!reader) return;
      if (a === 'prev') reader.step(-1);
      else if (a === 'next') reader.step(1);
      else if (a === 'in') reader.zoomIn();
      else if (a === 'out') reader.zoomOut();
      else if (a === 'fit') reader.fit();
    });
    const pageInput = readerEl?.querySelector<HTMLInputElement>('[data-rd-page]');
    pageInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        reader?.go(Number(pageInput.value));
        pageInput.select();
      }
    });
    pageInput?.addEventListener('change', () => reader?.go(Number(pageInput.value)));
    readerEl?.addEventListener('keydown', (e) => {
      if (!reader || (e.target as HTMLElement).closest('input')) return;
      const mod = e.metaKey || e.ctrlKey;
      if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        reader.zoomIn();
      } else if (e.key === '-') {
        e.preventDefault();
        reader.zoomOut();
      } else if (mod && e.key === '0') {
        e.preventDefault();
        reader.fit();
      }
    });

    // ------------------------------------------------------------------
    // Doodle: draw mode over the wallpaper.
    // ------------------------------------------------------------------
    const doodle = initDoodle(desk, {
      onOpen: () => {
        desk.querySelector('[data-desk-open="doodle"].dock-item')?.classList.add('is-running');
        // Phones: the Welcome sheet covers half the screen, so tuck it away.
        const w = wins.get('welcome');
        if (small.matches && w) hideWin(w, 'closed');
      },
      onClose: () => {
        desk.querySelector('[data-desk-open="doodle"].dock-item')?.classList.remove('is-running');
        desk.querySelector<HTMLElement>('.desk-icon[data-desk-open="doodle"]')?.focus({
          preventScroll: true,
        });
      },
    });

    // Re-clamp after resizes and phone rotation (the new size lands a frame later).
    const reclamp = () => requestAnimationFrame(() => wins.forEach(clampWin));
    window.addEventListener('resize', reclamp);
    window.addEventListener('orientationchange', reclamp);
    window.visualViewport?.addEventListener('resize', reclamp);
    small.addEventListener('change', () => wins.forEach(resetPos));

    // Escape peels one layer at a time: draw mode, then AmReader, then the desktop.
    const onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape' || !open) return;
      e.preventDefault();
      e.stopPropagation();
      if (doodle?.isOn()) return doodle.close();
      const rd = wins.get('reader');
      if (rd && rd.state === 'open') return hideWin(rd, 'closed');
      skip();
    };
    const clearSelection = () =>
      desk
        .querySelectorAll('.desk-icon.is-selected')
        .forEach((i) => i.classList.remove('is-selected'));

    const activate = () => {
      open = true;
      runClock();
      document.addEventListener('keydown', onKey, true);
      ide?.setAttribute('inert', '');
    };
    const deactivate = (focusSel?: string) => {
      open = false;
      doodle?.close();
      busy = false;
      stopClock();
      document.removeEventListener('keydown', onKey, true);
      html.classList.remove('desk-on', 'desk-opening');
      ide?.classList.remove('ide-zoom', 'ide-shrink');
      ide?.removeAttribute('inert');
      if (ide) ide.style.transformOrigin = '';
      clearSelection();
      const target =
        (focusSel && document.querySelector<HTMLElement>(focusSel)) ||
        (returnFocus?.isConnected ? returnFocus : null) ||
        document.querySelector<HTMLElement>('#main');
      target?.focus({ preventScroll: true });
      returnFocus = null;
    };

    const originAt = (el: Element) => {
      const r = el.getBoundingClientRect();
      return `${r.left + r.width / 2}px ${r.top + r.height / 2}px`;
    };

    const openApp = (app: string, from?: Element | null) => {
      if (!open || busy) return;
      if (wins.has(app)) return showWin(wins.get(app)!);
      if (app === 'doodle') return doodle?.isOn() ? doodle.close() : doodle?.open();
      if (app === 'simple') {
        try {
          localStorage.setItem('adam-view', 'classic');
        } catch {
          /* private mode */
        }
        location.href = '/classic';
        return;
      }
      const w = window as any;
      if (app === 'postam') w.ide?.open?.('postam');
      const focusSel = app === 'postam' ? '[data-pm-url]' : undefined;
      if (reduceMq.matches || !ide || !from) return deactivate(focusSel);
      busy = true;
      ide.removeAttribute('inert');
      ide.style.transformOrigin = originAt(from);
      html.classList.add('desk-opening');
      ide.classList.add('ide-zoom');
      window.setTimeout(() => deactivate(focusSel), 560);
    };

    const skip = () => {
      if (!open || busy) return;
      deactivate();
    };

    /** Back to the desktop from AmCode (red / yellow light, palette, terminal). */
    const show = () => {
      if (open || busy) return;
      returnFocus = document.activeElement as HTMLElement | null;
      // Coming back on purpose: the skip button now reads as a way back.
      const skipLabel = desk.querySelector('[data-desk-skip]')?.firstChild;
      if (skipLabel?.nodeType === Node.TEXT_NODE) skipLabel.textContent = 'Back to AmCode ';
      window.dispatchEvent(new CustomEvent('ide:before-desktop'));
      html.classList.add('desk-on');
      activate();
      const icon = amIcon();
      const done = () => {
        busy = false;
        ide?.classList.remove('ide-shrink');
        if (ide) ide.style.transformOrigin = '';
        icon?.focus({ preventScroll: true });
      };
      if (reduceMq.matches || !ide || !icon) return done();
      busy = true;
      ide.style.transformOrigin = originAt(icon.querySelector('svg') || icon);
      ide.classList.add('ide-shrink');
      window.setTimeout(done, 480);
    };
    (window as any).amDesk = { show, isOpen: () => open };

    desk.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-desk-skip]')) return skip();
      const winBtn = t.closest<HTMLElement>('[data-desk-win]');
      if (winBtn) {
        const w = wins.get(winBtn.closest<HTMLElement>('[data-win]')?.dataset.win || '');
        if (!w) return;
        const a = winBtn.dataset.deskWin;
        if (a === 'close') return hideWin(w, 'closed');
        if (a === 'min') return hideWin(w, 'min');
        return zoomWin(w);
      }
      if (t.closest('[data-win],[data-doodle-bar]') && !t.closest('[data-desk-open]')) return;
      const btn = t.closest<HTMLElement>('[data-desk-open]');
      if (!btn) return clearSelection();
      // The resume link stays a real link (new tab, middle-click), but a plain
      // click opens it in AmReader instead.
      if (btn.tagName === 'A') {
        const me = e as MouseEvent;
        if (me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
        e.preventDefault();
      }
      // Desktop icons: click selects, double-click opens (keyboard and touch open at once).
      // Dock items open on a single click, like a real dock.
      const isIcon = btn.classList.contains('desk-icon');
      if (isIcon && !coarse && e.detail > 0) {
        clearSelection();
        btn.classList.add('is-selected');
        if (e.detail < 2) return;
      }
      openApp(btn.dataset.deskOpen!, btn.querySelector('svg') || btn);
    });

    if (html.classList.contains('desk-on')) {
      activate();
      amIcon()?.focus({ preventScroll: true });
    }
  }
</script>
