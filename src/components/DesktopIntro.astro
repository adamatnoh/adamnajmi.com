---
/**
 * First-visit desktop. Hidden unless the head gate in SeoHead adds
 * `desk-on` to <html> (once per session, never for deep links). The editor
 * is already rendered underneath; opening AmCode zooms it out of the icon.
 */
import AppIcon from './brand/AppIcon.astro';
import { PROFILE, RESUME_URL } from '../data/profile';
---

<div
  id="desk"
  class="desk"
  role="dialog"
  aria-modal="true"
  aria-labelledby="desk-hello"
  aria-describedby="desk-hint"
  data-cipher-ui
>
  <div class="desk-wall" aria-hidden="true">
    <span class="desk-mark">{'{ an }'}</span>
  </div>

  <header class="desk-bar">
    <span class="desk-brand">
      <AppIcon name="amcode" size={16} />
      <span>adamnajmi.com</span>
    </span>
    <span class="desk-clock">
      <span data-desk-date></span>
      <time data-desk-time>--:--</time>
    </span>
  </header>

  <ul class="desk-icons" aria-label="Apps">
    <li>
      <button type="button" class="desk-icon" data-desk-open="amcode" data-desk-first>
        <AppIcon name="amcode" size={58} />
        <span>AmCode</span>
      </button>
    </li>
    <li>
      <button type="button" class="desk-icon" data-desk-open="postam">
        <AppIcon name="postam" size={58} />
        <span>PostAm</span>
      </button>
    </li>
    <li>
      <button type="button" class="desk-icon" data-desk-open="simple">
        <AppIcon name="simple" size={58} />
        <span>Simple view</span>
      </button>
    </li>
    <li>
      <a class="desk-icon" href={RESUME_URL} target="_blank" rel="noopener">
        <AppIcon name="pdf" size={58} />
        <span>resume.pdf</span>
      </a>
    </li>
  </ul>

  <section class="desk-card">
    <p class="desk-kicker">Hi, I'm</p>
    <h2 id="desk-hello">Adam Najmi</h2>
    <p class="desk-role">{PROFILE.role} · Johor Bahru, MY</p>
    <p class="desk-hint" id="desk-hint">
      <span class="only-fine">Double-click</span><span class="only-coarse">Tap</span>
      <b>AmCode</b> to open my portfolio as a code editor, <b>PostAm</b> to call its live API, or pick
      <b>Simple view</b> for a plain page.
    </p>
    <div class="desk-actions">
      <button type="button" class="desk-btn primary" data-desk-open="amcode">
        <AppIcon name="amcode" size={18} /> Open AmCode
      </button>
      <button type="button" class="desk-btn" data-desk-open="simple">
        <AppIcon name="simple" size={18} /> Simple view
      </button>
    </div>
  </section>

  <button type="button" class="desk-skip" data-desk-skip aria-keyshortcuts="Escape">
    Skip intro <kbd aria-hidden="true">esc</kbd>
  </button>
</div>

<script>
  /**
   * The desktop stays in the DOM (hidden) so AmCode can return to it:
   * window.amDesk.show(from) shrinks the editor back into the AmCode icon.
   * Tabs and layout are untouched, so reopening restores them.
   */
  const html = document.documentElement;
  const desk = document.getElementById('desk');

  if (desk) {
    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const ide = document.getElementById('ide');
    const amIcon = () => desk.querySelector<HTMLElement>('[data-desk-first]');

    // Clock + date in the visitor's own time.
    const timeEl = desk.querySelector<HTMLElement>('[data-desk-time]');
    const dateEl = desk.querySelector<HTMLElement>('[data-desk-date]');
    const tick = () => {
      const now = new Date();
      if (timeEl) {
        timeEl.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        timeEl.dateTime = now.toISOString();
      }
      if (dateEl)
        dateEl.textContent = now.toLocaleDateString([], {
          weekday: 'short',
          day: 'numeric',
          month: 'short',
        });
    };
    let clock = 0;
    let open = false; // desktop currently showing
    let busy = false; // an animation is running
    let returnFocus: HTMLElement | null = null;

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && open) {
        e.preventDefault();
        e.stopPropagation();
        skip();
      }
    };
    const clearSelection = () =>
      desk
        .querySelectorAll('.desk-icon.is-selected')
        .forEach((i) => i.classList.remove('is-selected'));

    const activate = () => {
      open = true;
      tick();
      window.clearInterval(clock);
      clock = window.setInterval(tick, 15_000);
      document.addEventListener('keydown', onKey, true);
      ide?.setAttribute('inert', '');
    };
    const deactivate = (focusSel?: string) => {
      open = false;
      busy = false;
      window.clearInterval(clock);
      document.removeEventListener('keydown', onKey, true);
      html.classList.remove('desk-on', 'desk-opening');
      ide?.classList.remove('ide-zoom', 'ide-shrink');
      ide?.removeAttribute('inert');
      if (ide) ide.style.transformOrigin = '';
      clearSelection();
      const target =
        (focusSel && document.querySelector<HTMLElement>(focusSel)) ||
        (returnFocus?.isConnected ? returnFocus : null) ||
        document.querySelector<HTMLElement>('#main');
      target?.focus({ preventScroll: true });
      returnFocus = null;
    };

    const originAt = (el: Element) => {
      const r = el.getBoundingClientRect();
      return `${r.left + r.width / 2}px ${r.top + r.height / 2}px`;
    };

    const openApp = (app: string, from?: Element | null) => {
      if (!open || busy) return;
      if (app === 'simple') {
        try {
          localStorage.setItem('adam-view', 'classic');
        } catch {
          /* private mode */
        }
        location.href = '/classic';
        return;
      }
      const w = window as any;
      if (app === 'postam') w.ide?.open?.('postam');
      const focusSel = app === 'postam' ? '[data-pm-url]' : undefined;
      if (reduceMq.matches || !ide || !from) return deactivate(focusSel);
      busy = true;
      ide.removeAttribute('inert');
      ide.style.transformOrigin = originAt(from);
      html.classList.add('desk-opening');
      ide.classList.add('ide-zoom');
      window.setTimeout(() => deactivate(focusSel), 560);
    };

    const skip = () => {
      if (!open || busy) return;
      deactivate();
    };

    /** Back to the desktop from AmCode (red / yellow light, palette, terminal). */
    const show = () => {
      if (open || busy) return;
      returnFocus = document.activeElement as HTMLElement | null;
      // Coming back on purpose: the skip button now reads as a way back.
      const skipLabel = desk.querySelector('[data-desk-skip]')?.firstChild;
      if (skipLabel?.nodeType === Node.TEXT_NODE) skipLabel.textContent = 'Back to AmCode ';
      window.dispatchEvent(new CustomEvent('ide:before-desktop'));
      html.classList.add('desk-on');
      activate();
      const icon = amIcon();
      const done = () => {
        busy = false;
        ide?.classList.remove('ide-shrink');
        if (ide) ide.style.transformOrigin = '';
        icon?.focus({ preventScroll: true });
      };
      if (reduceMq.matches || !ide || !icon) return done();
      busy = true;
      ide.style.transformOrigin = originAt(icon.querySelector('svg') || icon);
      ide.classList.add('ide-shrink');
      window.setTimeout(done, 480);
    };
    (window as any).amDesk = { show, isOpen: () => open };

    desk.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-desk-skip]')) return skip();
      const btn = t.closest<HTMLElement>('[data-desk-open]');
      if (!btn) return clearSelection();
      // Desktop icons: click selects, double-click opens (keyboard and touch open at once).
      const isIcon = btn.classList.contains('desk-icon');
      if (isIcon && !coarse && e.detail > 0) {
        clearSelection();
        btn.classList.add('is-selected');
        if (e.detail < 2) return;
      }
      openApp(btn.dataset.deskOpen!, btn.querySelector('svg') || btn);
    });

    if (html.classList.contains('desk-on')) {
      activate();
      amIcon()?.focus({ preventScroll: true });
    }
  }
</script>
