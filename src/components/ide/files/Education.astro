---
import { EDUCATION, CERTIFICATIONS, SPOKEN } from '../../../data/profile';
const issued = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleDateString('en-GB', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<div class="pv" data-gutter>
  <div class="gutter" aria-hidden="true"></div>
  <article class="md">
    <h1 style="font-size:2rem"><span class="hash" aria-hidden="true">#</span>education</h1>
    <p class="lead">Degrees, certification &amp; languages</p>

    {
      EDUCATION.map((e) => (
        <>
          <h2>
            <span class="hash" aria-hidden="true">
              ##
            </span>
            {e.school}
          </h2>
          <p>{e.award}</p>
          <p class="mono muted small">{[e.period, e.grade].filter(Boolean).join(' · ')}</p>
        </>
      ))
    }

    {
      CERTIFICATIONS.map((c) => (
        <>
          <h2>
            <span class="hash" aria-hidden="true">
              ##
            </span>
            {c.name}
          </h2>
          <p>
            {c.code} · {c.issuer}
          </p>
          <p class="mono muted small">Issued {issued(c.issued)}</p>
          <div class="btns" data-no-cipher>
            <a class="btn" data-no-cipher href={c.verify} target="_blank" rel="noopener noreferrer">
              Verify on Credly ↗
            </a>
          </div>
        </>
      ))
    }

    <h2><span class="hash" aria-hidden="true">##</span>Languages</h2>
    <ul class="bullets">
      {
        Object.entries(SPOKEN).map(([lang, level]) => (
          <li>
            {lang} — {level}
          </li>
        ))
      }
    </ul>
  </article>
</div>
