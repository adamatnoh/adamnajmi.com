---
import Icon from './Icon.astro';
import AppIcon from '../brand/AppIcon.astro';
---

<div class="ide-titlebar" data-no-cipher>
  <div class="tb-left">
    <button
      type="button"
      class="icon-btn tb-burger"
      data-action="toggle-sidebar"
      aria-label="Open explorer"
      aria-controls="ide-left"
    >
      <Icon name="menu" />
    </button>
    <div class="tb-dots" role="group" aria-label="Window">
      <button
        type="button"
        class="tb-dot close"
        data-action="desktop"
        aria-label="Close AmCode and go back to the desktop"
        title="Back to desktop"
        ><svg viewBox="0 0 12 12" aria-hidden="true"
          ><path d="M3.5 3.5l5 5M8.5 3.5l-5 5"></path></svg
        ></button
      >
      <button
        type="button"
        class="tb-dot min"
        data-action="desktop"
        aria-label="Minimize AmCode to the desktop"
        title="Minimize to desktop"
        ><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 6h6"></path></svg></button
      >
      <button
        type="button"
        class="tb-dot max"
        data-action="fullscreen"
        aria-label="Toggle full screen"
        title="Full screen"
        ><svg viewBox="0 0 12 12" aria-hidden="true"
          ><path d="M4 8V4h4M8 4 4 8" transform="translate(-.4 .4)"></path></svg
        ></button
      >
    </div>
    <span class="tb-app" title="AmCode"
      ><AppIcon name="amcode" size={16} /><span class="hide-sm">AmCode</span></span
    >
    <div class="tb-menu hide-sm" aria-hidden="true">
      <span>File</span><span>Edit</span><span>Selection</span><span>View</span><span>Go</span><span
        >Run</span
      ><span>Terminal</span><span>Help</span>
    </div>
  </div>
  <button
    type="button"
    class="tb-command"
    data-action="palette"
    aria-label="Search files and commands"
    aria-keyshortcuts="Control+Shift+P Meta+Shift+P Control+K Meta+K"
  >
    <Icon name="search" size={13} />
    <span class="tb-title">adamnajmi.com — AmCode</span>
    <kbd data-kbd>Ctrl Shift P</kbd>
  </button>
  <div class="tb-right">
    <span class="tb-layout">
      <button
        type="button"
        class="icon-btn"
        data-action="toggle-sidebar"
        data-pressed-for="sidebar"
        aria-label="Toggle primary side bar"
        title="Toggle Primary Side Bar (Ctrl+B)"
      >
        <Icon name="sidebar" />
      </button>
      <button
        type="button"
        class="icon-btn"
        data-action="toggle-panel"
        data-pressed-for="panel"
        aria-label="Toggle panel"
        title="Toggle Panel (Ctrl+`)"
      >
        <Icon name="panel" />
      </button>
      <button
        type="button"
        class="icon-btn"
        data-action="toggle-chat"
        data-pressed-for="chat"
        aria-label="Toggle Ask Adam chat"
        title="Toggle Ask Adam"
      >
        <Icon name="chat-panel" />
      </button>
    </span>
    <button
      type="button"
      class="icon-btn tb-desk-mobile"
      data-action="desktop"
      aria-label="Back to desktop"
      title="Back to desktop"
    >
      <Icon name="desktop" />
    </button>
    <button
      type="button"
      class="icon-btn tb-chat-mobile"
      data-action="toggle-chat"
      aria-label="Open Ask Adam chat"
      aria-controls="ide-chat"
    >
      <Icon name="sparkle" />
    </button>
  </div>
</div>
