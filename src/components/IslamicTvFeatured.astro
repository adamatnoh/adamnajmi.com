---
import FeaturedChrome from './FeaturedChrome.astro';

const shots = [
  {
    src: '/file/islamic-tv/home-putra.webp',
    alt: 'Actual Xiaomi stick Home with Masjid Putra wallpaper, prayer times and countdown; network and QR redacted',
  },
  {
    src: '/file/islamic-tv/prayer-clock-putra.webp',
    alt: 'Actual prayer clock with Hijri date, five prayer times and a Quran verse over Masjid Putra',
  },
  {
    src: '/file/islamic-tv/child-lock-menu.webp',
    alt: 'Actual app context menu showing the child-lock entry, not the locked-app screen; network and QR redacted',
  },
  {
    src: '/file/islamic-tv/child-lock-qr-redacted.webp',
    alt: 'Actual child-lock QR unlock interface for YouTube; functional QR, complete unlock link and private household message visibly redacted',
  },
];
---

<FeaturedChrome
  id="islamic-tv-featured-title"
  title="islamic-tv-launcher"
  badge="side project · Android TV"
  badgeTone="green"
  accent="green"
>
  <p class="mt-2 max-w-3xl font-mono text-sm leading-relaxed text-white/70">
    Android TV home launcher with JAKIM prayer times, azan alerts, child lock and an Islamic-themed
    screensaver.
  </p>

  <ul class="mt-4 grid gap-x-4 gap-y-1.5 font-mono text-[13px] text-white/70 sm:grid-cols-2">
    <li><span class="text-green-400/70" aria-hidden="true">&gt;</span> Custom Android TV home</li>
    <li><span class="text-green-400/70" aria-hidden="true">&gt;</span> JAKIM prayer times + azan</li>
    <li><span class="text-green-400/70" aria-hidden="true">&gt;</span> Child lock / parental controls</li>
    <li><span class="text-green-400/70" aria-hidden="true">&gt;</span> Islamic screensaver</li>
  </ul>

  <div class="mt-4 flex flex-wrap gap-2">
    {
      ['Java', 'Android TV'].map((t) => (
        <span class="rounded border border-cyan-400/30 bg-cyan-400/5 px-2 py-0.5 font-mono text-[11px] text-cyan-300">
          {t}
        </span>
      ))
    }
  </div>

  <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-4">
    {
      shots.map((s) => (
        <figure class="overflow-hidden rounded-md border border-white/10 bg-black">
          <img
            src={s.src}
            alt={s.alt}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="aspect-video w-full object-cover"
          />
        </figure>
      ))
    }
  </div>
  <figure class="mx-auto mt-4 max-w-[360px] overflow-hidden rounded-md border border-white/10 bg-black">
    <img
      src="/file/islamic-tv/web-remote-offline.webp"
      alt="Web remote (offline UI preview; controls disabled)"
      width="450"
      height="760"
      loading="lazy"
      decoding="async"
      class="h-auto w-full object-contain"
    />
    <figcaption class="p-3 font-mono text-[11px] leading-relaxed text-white/60">
      Web remote (offline UI preview; controls disabled)
      <span class="mt-1 block text-white/40">Uncropped copy of the actual device UI; offline labels retained. Not live control verification.</span>
    </figcaption>
  </figure>
  <p class="mt-2 font-mono text-[10px] text-white/35">
    Actual device captures · network, functional QR and household message redacted. Wallpaper: Masjid Putra — CEphoto, Uwe Aranas
    <a
      href="https://creativecommons.org/licenses/by-sa/3.0/"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-white/55">CC BY-SA 3.0</a
    >.
  </p>

  <div class="mt-5">
    <a
      href="https://github.com/adamatnoh/islamic-tv-launcher"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-md border border-white/20 px-4 py-2 font-mono text-sm text-white transition hover:bg-white hover:text-black"
    >
      View on GitHub <span aria-hidden="true">↗</span>
    </a>
  </div>
</FeaturedChrome>
