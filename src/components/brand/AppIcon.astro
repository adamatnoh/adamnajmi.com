---
/**
 * Original app icons for the desktop intro and the editor chrome.
 * AmCode (the editor), PostAm (the API client), Simple view, a PDF, Doodle
 * (the scribble canvas) and AmReader (the PDF viewer).
 * Drawn from scratch: no third-party logos or trademarks.
 */
interface Props {
  name: 'amcode' | 'postam' | 'simple' | 'pdf' | 'welcome' | 'doodle' | 'reader';
  size?: number;
  class?: string;
  title?: string;
}
const { name, size = 48, class: className, title } = Astro.props;
// Gradient ids must be unique per instance.
const uid = `${name}-${Math.random().toString(36).slice(2, 8)}`;
const GRAD: Record<Props['name'], [string, string]> = {
  amcode: ['#3FA6F2', '#0065A9'],
  postam: ['#FF8A5B', '#E8541F'],
  simple: ['#60a5fa', '#1e40af'],
  pdf: ['#f1f5f9', '#cbd5e1'],
  welcome: ['#34d399', '#0284c7'],
  doodle: ['#f472b6', '#f97316'],
  reader: ['#6366f1', '#0f172a'],
};
const [c1, c2] = GRAD[name];
// PostAm is a round badge; every other app is a squircle.
const round = name === 'postam';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  <defs>
    <linearGradient id={`g-${uid}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={c1}></stop>
      <stop offset="1" stop-color={c2}></stop>
    </linearGradient>
  </defs>
  {
    round ? (
      <>
        <circle cx="32" cy="32" r="29" fill={`url(#g-${uid})`} />
        <circle cx="32" cy="32" r="28.5" fill="none" stroke="#fff" stroke-opacity=".22" />
      </>
    ) : (
      <>
        <rect x="3" y="3" width="58" height="58" rx="15" fill={`url(#g-${uid})`} />
        <rect
          x="3.5"
          y="3.5"
          width="57"
          height="57"
          rx="14.5"
          fill="none"
          stroke="#fff"
          stroke-opacity=".22"
        />
      </>
    )
  }
  {
    name === 'amcode' && (
      <g fill="#fff">
        {/* A folded ribbon drawn as </>: each chevron has a lit and a shaded facet. */}
        <path d="M21 17.5 26.5 23l-9 9H8z" />
        <path d="M8 32h9.5l9 9-5.5 5.5z" fill-opacity=".68" />
        <path d="M43 17.5 37.5 23l9 9H56z" fill-opacity=".68" />
        <path d="M56 32h-9.5l-9 9 5.5 5.5z" />
        <path d="M35 15h4L29 49h-4z" fill-opacity=".9" />
      </g>
    )
  }
  {
    name === 'postam' && (
      <g stroke-linejoin="round">
        {/* Paper plane: "send a request". */}
        <path d="M14.5 31.5 48 17 36.5 48l-6-11.5z" fill="#fff" stroke="#fff" stroke-width="1.5" />
        <path d="M30.5 36.5 48 17 34 41.5z" fill="#FFD6C4" />
      </g>
    )
  }
  {
    name === 'simple' && (
      <g fill="none" stroke="#fff" stroke-linecap="round" stroke-width="3.5">
        <rect x="15" y="15" width="34" height="34" rx="5" stroke-opacity=".9" />
        <path d="M15 24h34" />
        <path d="M22 32h20M22 39h13" stroke-opacity=".8" />
      </g>
    )
  }
  {
    name === 'welcome' && (
      <g>
        <path
          d="M18 17h28a5 5 0 0 1 5 5v15a5 5 0 0 1-5 5H31l-8 7v-7h-5a5 5 0 0 1-5-5V22a5 5 0 0 1 5-5z"
          fill="#fff"
        />
        <text
          x="32"
          y="35"
          text-anchor="middle"
          font-family="ui-sans-serif,system-ui,sans-serif"
          font-size="13"
          font-weight="800"
          fill="#0369a1"
        >
          hi!
        </text>
      </g>
    )
  }
  {
    name === 'doodle' && (
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path
          d="M14 42c5-9 9-13 12-11s-4 10 0 11 9-15 13-13-3 12 1 13 6-4 9-7"
          stroke="#fff"
          stroke-width="4.5"
        />
        <path d="M40 15l9 9-15 15-11 3 3-11z" fill="#fff" stroke="#fff" stroke-width="2" />
        <path d="M40 15l9 9" stroke="#fb7185" stroke-width="5" />
        <circle cx="25.5" cy="38.5" r="1.8" fill="#9f1239" stroke="none" />
      </g>
    )
  }
  {
    name === 'reader' && (
      <g>
        <path d="M18 12h20l9 9v31H18z" fill="#fff" />
        <path d="M38 12v9h9" fill="#c7d2fe" />
        <path
          d="M23 25h12M23 30h18M23 35h18M23 40h11"
          stroke="#94a3b8"
          stroke-width="2.4"
          stroke-linecap="round"
        />
        <circle cx="40" cy="44" r="7.5" fill="#6366f1" stroke="#fff" stroke-width="2.5" />
        <path d="M37 44h6M40 41v6" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
      </g>
    )
  }
  {
    name === 'pdf' && (
      <g>
        <path d="M20 13h17l9 9v29H20z" fill="#fff" stroke="#94a3b8" stroke-width="2" />
        <path d="M37 13v9h9" fill="none" stroke="#94a3b8" stroke-width="2" />
        <rect x="16" y="35" width="24" height="11" rx="3" fill="#dc2626" />
        <text
          x="28"
          y="43.5"
          text-anchor="middle"
          font-family="ui-sans-serif,system-ui,sans-serif"
          font-size="8"
          font-weight="700"
          fill="#fff"
        >
          PDF
        </text>
      </g>
    )
  }
</svg>
