---
// First-load identity reveal. Hidden unless `boot-intro-on` is set on <html>
// before paint. The real page (and its h1) stays in the document underneath.
---

<div id="boot-intro" class="boot-intro" data-cipher-ui>
  <div class="boot-glow" aria-hidden="true"></div>
  <button
    type="button"
    class="boot-skip font-mono text-xs text-white/80 border border-white/25 rounded-md hover:text-white hover:border-white/50 transition-colors"
    data-boot-skip
    aria-label="Skip intro"
    aria-keyshortcuts="Escape"
  >
    skip
    <kbd class="boot-kbd" aria-hidden="true">esc</kbd>
  </button>

  <div
    class="boot-card w-full max-w-[40rem] bg-black border border-white/10 rounded-lg font-mono"
    aria-hidden="true"
  >
    <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3 sm:px-5">
      <span class="boot-dot bg-red-500"></span>
      <span class="boot-dot bg-yellow-500"></span>
      <span class="boot-dot bg-green-500"></span>
      <span class="ml-2 text-xs text-white/40">zsh — adamnajmi</span>
    </div>
    <div class="px-5 py-5 sm:px-7 sm:py-6">
      <p class="boot-line text-sm sm:text-base">
        <span class="text-green-400">➜</span>
        <span class="text-white/60"> ~</span>
        <span class="text-white"> whoami</span>
      </p>
      <p class="boot-name text-white">Adam Najmi</p>
      <div class="boot-rule"></div>
      <p class="boot-role text-white/80">
        Full Stack Software Engineer<span class="boot-caret cursor-blink"></span>
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('boot-intro');
    if (!root) return;

    let reduce = false;
    try {
      reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch {
      reduce = false;
    }

    // No class means this session already saw it, motion is reduced, or storage
    // failed closed. Drop the node so it never sits in the tab order.
    if (reduce || !document.documentElement.classList.contains('boot-intro-on')) {
      root.remove();
      document.documentElement.classList.remove('boot-intro-on');
      return;
    }

    let closed = false;
    let finished = false;

    const finish = () => {
      if (finished) return;
      finished = true;
      document.removeEventListener('keydown', onKey);
      window.removeEventListener('wheel', onWheel);
      root.removeEventListener('touchmove', onTouchMove);
      if (root.isConnected) root.remove();
      document.documentElement.classList.remove('boot-intro-on');
    };

    const close = () => {
      if (closed) return;
      closed = true;
      const skip = root.querySelector('[data-boot-skip]');
      if (skip) skip.setAttribute('tabindex', '-1');
      // Release the page immediately; the fade is visual only.
      root.style.pointerEvents = 'none';
      root.classList.add('is-done');
      window.setTimeout(finish, 450);
    };

    const onKey = (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'Tab') {
        // Leave the tab order instead of cycling inside the overlay.
        close();
      }
    };

    const onWheel = (event) => {
      if (Math.abs(event.deltaY) < 8 && Math.abs(event.deltaX) < 8) return;
      close();
    };

    let touchY = null;
    root.addEventListener(
      'touchstart',
      (event) => {
        touchY = event.touches && event.touches[0] ? event.touches[0].clientY : null;
      },
      { passive: true },
    );
    const onTouchMove = (event) => {
      if (touchY == null || !event.touches || !event.touches[0]) return;
      if (Math.abs(event.touches[0].clientY - touchY) > 14) close();
    };

    // CSS retires the overlay on its own if this script dies before close().
    root.addEventListener('animationend', (event) => {
      if (event.target !== root) return;
      if (
        event.animationName !== 'boot-intro-leave' &&
        event.animationName !== 'boot-intro-retire'
      ) {
        return;
      }
      finish();
    });

    document.addEventListener('keydown', onKey);
    window.addEventListener('wheel', onWheel, { passive: true });
    root.addEventListener('touchmove', onTouchMove, { passive: true });
    root.addEventListener('click', close);
    document.querySelector('a[href="#main"]')?.addEventListener('click', close);

    // Name and role are both on screen before the fade. Hard stop if it never ends.
    window.setTimeout(close, 1900);
    window.setTimeout(finish, 3200);
  })();
</script>

<style>
  .boot-intro {
    --boot-glow: rgb(74 222 128 / 0.45);
    --boot-glow-spot: rgb(74 222 128 / 0.2);
    color: var(--page-fg);
  }

  :global(html.light) .boot-intro {
    --boot-glow: rgb(21 128 61 / 0.32);
    --boot-glow-spot: rgb(22 163 74 / 0.14);
  }

  .boot-intro::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at center, black 18%, transparent 74%);
  }

  .boot-glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(44rem, 92vw);
    height: 16rem;
    transform: translate(-50%, -50%);
    pointer-events: none;
    background: radial-gradient(ellipse at center, var(--boot-glow-spot), transparent 68%);
  }

  .boot-skip {
    position: absolute;
    z-index: 2;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.85rem;
    background: color-mix(in srgb, var(--page-bg) 72%, transparent);
    cursor: pointer;
  }

  .boot-kbd {
    margin-left: 0.45rem;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    font-family: inherit;
    font-size: 10px;
    line-height: 1.4;
    opacity: 0.6;
  }

  .boot-card {
    position: relative;
    z-index: 1;
    box-shadow:
      0 24px 70px rgb(0 0 0 / 0.45),
      0 0 48px rgb(74 222 128 / 0.07);
  }

  :global(html.light) .boot-card {
    box-shadow:
      0 18px 50px rgb(0 0 0 / 0.08),
      0 0 36px rgb(22 163 74 / 0.07);
  }

  .boot-dot {
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
  }

  .boot-name {
    margin: 0.85rem 0 0;
    font-weight: 700;
    font-size: clamp(1.85rem, 6.5vw, 4.05rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-shadow: 0 0 18px var(--boot-glow);
  }

  .boot-rule {
    height: 1px;
    width: min(100%, 16rem);
    margin: 0.85rem 0 0.85rem;
    transform-origin: left center;
    background: linear-gradient(90deg, rgb(74 222 128 / 0.9), rgb(74 222 128 / 0));
  }

  :global(html.light) .boot-rule {
    background: linear-gradient(90deg, rgb(21 128 61 / 0.75), rgb(21 128 61 / 0));
  }

  .boot-role {
    margin: 0;
    font-size: clamp(0.95rem, 2.6vw, 1.35rem);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .boot-caret {
    display: inline-block;
    width: 0.55ch;
    height: 0.9em;
    margin-left: 0.4rem;
    vertical-align: -0.08em;
    background: var(--color-green-400, #4ade80);
  }

  @media (prefers-reduced-motion: no-preference) {
    .boot-glow {
      animation: boot-glow 1.25s ease 0.12s both;
    }
    .boot-card {
      animation: boot-card-in 0.48s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .boot-line {
      animation: boot-rise 0.32s ease 0.05s both;
    }
    .boot-name {
      animation: boot-name-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.14s both;
    }
    .boot-rule {
      animation: boot-rule 0.32s ease 0.52s both;
    }
    .boot-role {
      animation: boot-rise 0.32s ease 0.62s both;
    }
  }

  @keyframes boot-glow {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.88);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes boot-card-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes boot-rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes boot-name-in {
    from {
      opacity: 0;
      filter: blur(5px);
      letter-spacing: 0.14em;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      filter: none;
      letter-spacing: -0.045em;
      transform: none;
    }
  }

  @keyframes boot-rule {
    from {
      opacity: 0;
      transform: scaleX(0.12);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (forced-colors: active) {
    .boot-glow,
    .boot-intro::before {
      display: none;
    }
    .boot-name {
      text-shadow: none;
    }
  }
</style>
