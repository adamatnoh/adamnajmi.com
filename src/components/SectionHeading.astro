---
interface Props {
  id: string;
  icon: string;
  title: string;
}
const { id, icon, title } = Astro.props;
---

<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-6 border-b border-white/10 pb-2">
  <span class="text-green-400 font-mono text-sm" aria-hidden="true">{icon}</span>
  <h2 id={id} class="text-2xl font-mono font-bold text-white">{title}</h2>
  <span class="text-white/40 text-sm font-mono"><slot /></span>
</div>
