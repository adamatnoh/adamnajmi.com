---
/**
 * Shared chrome for featured project cards so EduCeria / HSS / ClearTV
 * all share the same badge row, $ title, optional slug, and live pill.
 */
interface Props {
  id: string;
  title: string;
  slug?: string;
  badge: string;
  badgeTone?: 'green' | 'cyan';
  liveHost?: string;
  liveHref?: string;
  accent?: 'green' | 'cyan';
}
const {
  id,
  title,
  slug,
  badge,
  badgeTone = 'green',
  liveHost,
  liveHref,
  accent = 'green',
} = Astro.props;

const badgeClass =
  badgeTone === 'cyan'
    ? 'border-cyan-400/40 bg-cyan-400/10 text-cyan-300'
    : 'border-green-400/40 bg-green-400/10 text-green-400';

const shellAccent =
  accent === 'cyan'
    ? 'border-cyan-400/25 from-cyan-400/5 via-transparent to-green-400/5'
    : 'border-green-500/20 from-green-500/[0.06] via-transparent to-transparent';
---

<article
  class:list={[
    'relative mb-6 overflow-hidden rounded-xl border bg-gradient-to-br p-5 sm:p-6',
    shellAccent,
  ]}
  aria-labelledby={id}
  data-reveal
>
  <div class="mb-3 flex flex-wrap items-center gap-2 font-mono text-xs">
    <span class:list={['inline-flex items-center gap-1 rounded-full px-2.5 py-0.5', badgeClass]}>
      {badge}
    </span>
    {
      liveHost && (
        liveHref ? (
          <a
            href={liveHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-green-400/40 bg-green-400/10 px-2.5 py-0.5 text-green-400 transition hover:bg-green-400 hover:text-black"
          >
            <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-60" />
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-400" />
            </span>
            live at {liveHost}
          </a>
        ) : (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-white/15 px-2.5 py-0.5 text-white/70">
            <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-60" />
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-400" />
            </span>
            live at {liveHost}
          </span>
        )
      )
    }
  </div>

  <h3 id={id} class="font-mono text-xl font-bold text-white md:text-2xl">
    <span class="text-green-400" aria-hidden="true">$</span>
    {' '}{title}
  </h3>
  {
    slug && (
      <p class="mt-0.5 font-mono text-[11px] text-white/40">{slug}</p>
    )
  }

  <slot />
</article>
