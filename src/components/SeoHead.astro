---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  themeColor?: string;
}
const SITE = 'https://adamnajmi.com';
const {
  title = 'Adam Najmi · Full Stack Software Engineer',
  description = 'Adam Najmi is a Full Stack Software Engineer in Johor Bahru, Malaysia, building production web, mobile and data systems for fintech and government.',
  path = Astro.url.pathname,
  image = '/og.png',
  themeColor = '#0a0a0a',
} = Astro.props;
const canonical = new URL(path, SITE).toString();
const ogImage = new URL(image, SITE).toString();

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Adam Najmi Bin Mat Noh',
  alternateName: 'Adam Najmi',
  jobTitle: 'Full Stack Software Engineer',
  url: SITE,
  email: 'mailto:adamnajminoh@gmail.com',
  image: `${SITE}/file/adam.png`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Johor Bahru',
    addressRegion: 'Johor',
    addressCountry: 'MY',
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universiti Teknologi Malaysia' },
  sameAs: ['https://www.linkedin.com/in/adamnajmi', 'https://github.com/adamatnoh'],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Adam Najmi" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap.xml" />
<meta name="theme-color" content={themeColor} />
<meta name="color-scheme" content="dark light" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="adamnajmi.com" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(person)} />

<!-- Apply the saved theme before first paint so there is no flash. -->
<script is:inline>
  (() => {
    const param = new URLSearchParams(location.search).get('theme');
    if (param === 'light' || param === 'dark') localStorage.setItem('theme', param);
    const saved = localStorage.getItem('theme');
    const theme = saved === 'light' ? 'light' : 'dark';
    document.documentElement.classList.toggle('light', theme === 'light');
    document.documentElement.classList.toggle('dark', theme !== 'light');
  })();
</script>
<!--
  Intro gate, before first paint. The overlay is display:none unless this
  adds boot-intro-on. Reduced motion, a session that already played it, and
  any storage failure all leave the page alone. Content stays in the HTML.
-->
<style is:inline>
  #boot-intro {
    display: none;
  }
  html.boot-intro-on #boot-intro {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 80;
    margin: 0;
    box-sizing: border-box;
    padding: max(3.25rem, calc(env(safe-area-inset-top) + 2.75rem)) 1rem
      max(1.25rem, env(safe-area-inset-bottom));
    overflow: hidden;
    background: var(--page-bg, #0a0a0a);
    animation: boot-intro-retire 2.45s linear forwards;
  }
  html.boot-intro-on #boot-intro.is-done {
    pointer-events: none;
    animation: boot-intro-leave 0.3s ease forwards;
  }
  @keyframes boot-intro-retire {
    0%,
    86% {
      opacity: 1;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
  @keyframes boot-intro-leave {
    from {
      opacity: 1;
      visibility: visible;
    }
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #boot-intro {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      animation: none !important;
    }
  }
  @media print {
    #boot-intro {
      display: none !important;
    }
  }
</style>
<script is:inline>
  (() => {
    try {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('adam-intro-seen') === '1') return;
      sessionStorage.setItem('adam-intro-seen', '1');
      document.documentElement.classList.add('boot-intro-on');
    } catch {
      /* Can't remember a session: skip, so later navigations stay clear. */
    }
  })();
</script>
<Analytics />
