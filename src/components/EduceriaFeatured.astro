---
import Word from './Word.astro';

const EDUCERIA_URL = 'https://ceria.kemas.gov.my/';
---

<article
  class="mb-6 rounded-lg border border-cyan-400/25 bg-gradient-to-br from-cyan-400/5 via-transparent to-green-400/5 p-5 sm:p-6"
  data-reveal
  aria-labelledby="educeria-title"
>
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <span
      class="inline-flex items-center gap-1 rounded-full border border-cyan-400/40 bg-cyan-400/10 px-2.5 py-0.5 font-mono text-[11px] text-cyan-300"
    >
      work product · Mechanikos
    </span>
    <a
      href={EDUCERIA_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full border border-green-400/40 bg-green-400/10 px-2.5 py-0.5 font-mono text-[11px] text-green-400 hover:bg-green-400 hover:text-black transition"
    >
      <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-60"
        ></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-400"></span>
      </span>
      live at ceria.kemas.gov.my
    </a>
  </div>

  <h3 id="educeria-title" class="font-mono text-xl sm:text-2xl font-bold text-white">
    <span class="text-green-400" aria-hidden="true">$</span> Kemas EduCeria
  </h3>
  <p class="mt-2 font-mono text-sm text-white/70 max-w-3xl leading-relaxed">
    National MIS for 5,000+ TABIKA preschool centres under <Word word="KEMAS" /> (Ministry of Rural and
    Regional Development) — registration, GPS-verified attendance, digital library, and role-based access
    across centre / district / state / HQ. Built with Laravel, Vue 3 and TypeScript. Internal system name
    SPTK; the public product is <strong class="text-white font-semibold">Kemas EduCeria</strong>.
  </p>

  <ul class="mt-4 grid sm:grid-cols-2 gap-x-4 gap-y-1.5 font-mono text-[13px] text-white/70">
    <li>
      <span class="text-green-400/70" aria-hidden="true">&gt;</span> TABIKA &amp; TASKA registration
    </li>
    <li><span class="text-green-400/70" aria-hidden="true">&gt;</span> GPS-verified attendance</li>
    <li><span class="text-green-400/70" aria-hidden="true">&gt;</span> Digital library</li>
    <li><span class="text-green-400/70" aria-hidden="true">&gt;</span> RBAC across centre → HQ</li>
    <li>
      <span class="text-green-400/70" aria-hidden="true">&gt;</span> Playwright E2E + TS strict mode
    </li>
    <li>
      <span class="text-green-400/70" aria-hidden="true">&gt;</span> Cross-module (incl. finance)
    </li>
  </ul>

  <div class="mt-4 flex flex-wrap gap-2">
    {
      ['Laravel', 'Vue.js 3', 'TypeScript', 'Playwright'].map((t) => (
        <span class="rounded border border-cyan-400/30 bg-cyan-400/5 px-2 py-0.5 font-mono text-[11px] text-cyan-300">
          {t}
        </span>
      ))
    }
  </div>

  <div class="mt-5 flex flex-wrap gap-3">
    <a
      href={EDUCERIA_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-md bg-green-400 text-black font-mono font-bold text-sm px-4 py-2 hover:bg-green-300 transition"
    >
      <span aria-hidden="true">↗</span> Open Kemas EduCeria
    </a>
    <p class="self-center font-mono text-[11px] text-white/45 max-w-xs">
      Public production site for TABIKA &amp; TASKA <Word word="KEMAS" /> registration.
    </p>
  </div>
</article>
