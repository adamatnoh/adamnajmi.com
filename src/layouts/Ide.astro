---
import DesktopIntro from '../components/DesktopIntro.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';
import '../styles/ide.css';
import '../styles/desktop.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en" class="dark ide-page">
  <head>
    <SeoHead {...props} themeColor="#0a0c12" intro="desktop" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="antialiased">
    <a href="#main" class="skip-link">Skip to editor</a>
    <DesktopIntro />
    <slot />
  </body>
</html>
