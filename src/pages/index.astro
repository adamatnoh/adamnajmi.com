---
import Ide from '../layouts/Ide.astro';
import TitleBar from '../components/ide/TitleBar.astro';
import ActivityBar from '../components/ide/ActivityBar.astro';
import Sidebar from '../components/ide/Sidebar.astro';
import Panel from '../components/ide/Panel.astro';
import StatusBar from '../components/ide/StatusBar.astro';
import Palette from '../components/ide/Palette.astro';
import SimpleBrowser from '../components/ide/SimpleBrowser.astro';
import Welcome from '../components/ide/Welcome.astro';
import FileIcon from '../components/ide/FileIcon.astro';
import AskAdam from '../components/ide/AskAdam';
import PostAm from '../components/ide/PostAm.astro';
import AppIcon from '../components/brand/AppIcon.astro';
import Readme from '../components/ide/files/Readme.astro';
import About from '../components/ide/files/About.astro';
import Experience from '../components/ide/files/Experience.astro';
import Educeria from '../components/ide/files/Educeria.astro';
import Hss from '../components/ide/files/Hss.astro';
import Tv from '../components/ide/files/Tv.astro';
import Rapidz from '../components/ide/files/Rapidz.astro';
import Stack from '../components/ide/files/Stack.astro';
import Education from '../components/ide/files/Education.astro';
import Contact from '../components/ide/files/Contact.astro';
import Cipher from '../components/ide/files/Cipher.astro';
import { FILES, BROWSERS } from '../data/ide';
import '../styles/postam.css';

const PANES: Record<string, any> = {
  readme: Readme,
  about: About,
  experience: Experience,
  educeria: Educeria,
  hss: Hss,
  tv: Tv,
  rapidz: Rapidz,
  stack: Stack,
  education: Education,
  contact: Contact,
  cipher: Cipher,
};
const meta = JSON.stringify({
  files: FILES.map(({ id, name, path, icon, lang, aliases }) => ({
    id,
    name,
    path,
    icon,
    lang,
    aliases,
  })),
  browsers: BROWSERS.map(({ id, title, host }) => ({
    id,
    name: title,
    path: host,
    icon: 'browser',
    lang: 'Simple Browser',
  })),
  tools: [
    {
      id: 'postam',
      name: 'PostAm',
      path: 'PostAm',
      icon: 'postam',
      lang: 'PostAm · API client',
      aliases: ['api', 'postam'],
    },
  ],
});
---

<Ide>
  <div class="ide" id="ide" data-sidebar="open" data-panel="open" data-chat="open" data-meta={meta}>
    <TitleBar />
    <div class="ide-main">
      <div class="ide-left" id="ide-left">
        <ActivityBar />
        <Sidebar />
      </div>

      <div class="ide-work">
        <div class="editor-group">
          <div class="tabs" role="tablist" aria-label="Open editors" data-tabs data-no-cipher>
            <div class="tab is-active" role="presentation">
              <button
                type="button"
                class="tab-label"
                role="tab"
                aria-selected="true"
                aria-controls="pane-readme"
                id="tab-readme"
              >
                <FileIcon icon="md" /><span>README.md</span>
              </button>
            </div>
          </div>
          <div class="breadcrumbs" data-breadcrumbs data-no-cipher>
            <span>adamnajmi.com</span><span class="sep">›</span><FileIcon icon="md" /><span
              >README.md</span
            >
          </div>
          <main id="main" class="editor" tabindex="-1" aria-label="Editor">
            {
              FILES.map((f) => {
                const Pane = PANES[f.id];
                return (
                  <section
                    class:list={['pane', f.id === 'readme' && 'is-active']}
                    id={`pane-${f.id}`}
                    data-pane={f.id}
                    role="tabpanel"
                    aria-label={f.path}
                    tabindex="-1"
                  >
                    <Pane />
                  </section>
                );
              })
            }
            {
              BROWSERS.map((b) => (
                <section
                  class="pane"
                  id={`pane-${b.id}`}
                  data-pane={b.id}
                  role="tabpanel"
                  aria-label={b.title}
                  tabindex="-1"
                >
                  <SimpleBrowser tab={b} />
                </section>
              ))
            }
            <section
              class="pane pane-tool"
              id="pane-postam"
              data-pane="postam"
              role="tabpanel"
              aria-label="PostAm API client"
              tabindex="-1"
            >
              <PostAm />
            </section>
            <section
              class="pane"
              id="pane-welcome"
              data-pane="welcome"
              aria-label="No editor open"
              tabindex="-1"
            >
              <Welcome />
            </section>
          </main>
        </div>
        <Panel />
      </div>

      <aside class="ide-chat" id="ide-chat" aria-label="Ask Adam" data-cipher-ui>
        <AskAdam client:load />
      </aside>
    </div>
    <StatusBar />
    <div class="ide-scrim" data-action="close-drawers" aria-hidden="true"></div>
    <Palette />
    <template id="ficon-postam"><AppIcon name="postam" size={14} /></template>
  </div>
</Ide>

<script>
  import '../scripts/ide';
  import '../scripts/postam';
</script>
